+# [continuum-npu observation patch: steptime v2] Off unless CONTINUUM_OBS_STEPTIME=1;
+# when off every added statement is a constant-false branch or a 0.0 assignment.
+_OBS_STEPTIME = __import__("os").environ.get("CONTINUUM_OBS_STEPTIME", "") == "1"
+_OBS_BUF: list = []
+_OBS_LAST = [0.0]
