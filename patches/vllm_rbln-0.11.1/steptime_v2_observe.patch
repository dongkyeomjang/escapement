+def _obs_flush() -> None:
+    if _OBS_BUF:
+        logger.debug("[STEPTIME2] %s", ";".join(_OBS_BUF))
+        _OBS_BUF.clear()
+
+
+if _OBS_STEPTIME:
+    __import__("atexit").register(_obs_flush)


