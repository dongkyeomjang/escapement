{
  "schema": "anon-targets-v1",
  "about": "Identity strings for tools/anon_export.py. Entries apply top to bottom. auto=true entries are applied; auto=false entries need a user decision: set decision to 'apply' or 'keep' (or pass --apply/--keep ID).",
  "generic_checks": {
    "home_path": "/home/",
    "email": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}",
    "github_owner": "github\\.com[:/]([A-Za-z0-9_.-]+)",
    "github_owner_allow": [
      "girder",
      "Kiln-AI",
      "vllm-project",
      "rebellions-sw",
      "RBLN-SW",
      "huggingface",
      "pytorch",
      "openai",
      "anthropics",
      "QwenLM"
    ],
    "email_allow": []
  },
  "export_exclude": [
    "tools/anon_targets.json",
    "tools/ANON_TARGETS.md",
    "tools/anon_occurrences.csv",
    "tools/anon_export.py",
    ".idea/"
  ],
