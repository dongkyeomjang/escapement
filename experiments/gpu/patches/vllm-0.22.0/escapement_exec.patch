 logger = init_logger(__name__)
 # ESCAPEMENT observation-only patch (GTASK03): log lines only, gated by env.
 _ESC_OBS = __import__("os").environ.get("ESCAPEMENT_OBS") == "1"
+# ESCAPEMENT exec-timing layer (GTASK23): CUDA events on the issuing stream at
+# step start / before forward / after sampling+postprocess. Read back only when
+# the end event has completed (no synchronisation); one [GEXEC] line per step.
+_ESC_EXEC = _ESC_OBS and __import__("os").environ.get("ESCAPEMENT_EXEC") == "1"
+_esc_pending: list = []
+_esc_state: dict = {"seq": 0, "ref": None}
+
+
+def _esc_exec_drain() -> None:
+    while _esc_pending and _esc_pending[0][3].query():
+        t, e0, e1, e2, seq = _esc_pending.pop(0)
+        logger.info(
+            "[GEXEC] seq=%d t=%.6f s=%.4f prep=%.4f run=%.4f",
+            seq, t, _esc_state["ref"].elapsed_time(e0), e0.elapsed_time(e1),
+            e1.elapsed_time(e2),
+        )
 
 
